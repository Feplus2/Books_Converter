# MinerU API Token — 从 https://mineru.net/apiManage/token 免费获取
MINERU_TOKEN=your_mineru_token_here

# DeepSeek API Key — 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 默认输出目录
DEFAULT_OUTPUT_DIR=./output

# MinerU 参数
MINERU_MODEL=vlm
MINERU_LANGUAGE=ch
MINERU_TIMEOUT=900
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true

# Popo 参数（Stage 2 本地 4B 后处理模型）
# 模型权重下载: hf download DreamEternal/MinerU-Popo --local-dir models/MinerU-Popo
POPO_MODEL_PATH=./models/MinerU-Popo
POPO_MAX_NEW_TOKENS=8192
