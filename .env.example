# MinerU API Token — 从 https://mineru.net/apiManage/token 免费获取
MINERU_TOKEN=your_mineru_token_here

# DeepSeek API Key — 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 默认输出目录
DEFAULT_OUTPUT_DIR=./output

# OCR 引擎（Stage 1）：mineru / paddleocr / vlm
OCR_PROVIDER=mineru

# ── VLM 逐页阅读引擎（多模态直读，见 wiki/06-vlm-pipeline.md）──
# 转写主力（默认智谱 z.ai 的 glm-5.3-flash；bigmodel 同构：https://open.bigmodel.cn/api/paas/v4）
VLM_API_KEY=your_zai_key_here
VLM_BASE_URL=https://api.z.ai/api/paas/v4
VLM_MODEL=glm-5.3-flash
VLM_REASONING=low
# 图片区域定位：bbox 粗框 + 本地光栅重裁收边。
# 留空 = 复用上面 VLM_API_KEY 的转写模型出粗框（零额外 key，默认推荐）；
# 追求极致精度可配火山豆包（T4 实验 IoU≥0.8 比例 100%）：
VLM_BBOX_API_KEY=
VLM_BBOX_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_BBOX_MODEL=doubao-seed-2-1-turbo-260628
VLM_WORKERS=4
VLM_DPI=150

# MinerU 参数
MINERU_MODEL=vlm
MINERU_LANGUAGE=ch
MINERU_TIMEOUT=900
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true

# PaddleOCR-VL 参数（百度 AI Studio，免费 3000 页/天/模型）
# Token 申请: https://ai.baidu.com/ai-doc/AISTUDIO/fml7mozw5
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=your_paddleocr_token_here
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_TIMEOUT=900
