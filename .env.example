# MinerU API Token — 从 https://mineru.net/apiManage/token 免费获取
MINERU_TOKEN=your_mineru_token_here

# DeepSeek API Key — 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 默认输出目录
DEFAULT_OUTPUT_DIR=./output

# OCR 引擎（Stage 1）：mineru / paddleocr
OCR_PROVIDER=mineru

# MinerU 参数
MINERU_MODEL=vlm
MINERU_LANGUAGE=ch
MINERU_TIMEOUT=900
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true

# PaddleOCR-VL 参数（百度 AI Studio，免费 3000 页/天/模型）
# Token 申请: https://ai.baidu.com/ai-doc/AISTUDIO/fml7mozw5
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=your_paddleocr_token_here
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_TIMEOUT=900
